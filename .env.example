# Postgres — optional for local dev (in-memory rooms are used when unset).
# Required in production so rooms survive server restarts and cloud relay works.
DATABASE_URL=postgresql://user:password@localhost:5432/sg16_transfer

# Public site URL (metadata, OG tags, share links)
NEXT_PUBLIC_SITE_URL=https://transfer.sg16engine.com

# Set when building the Android APK so the WebView hits your deployed backend
NEXT_PUBLIC_API_BASE=https://transfer.sg16engine.com
